# Copy to .env and fill in. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Leave unset to use the best free models with tool calling, with fallbacks
# (see src/macro_intelligence/models.py). Set it to always use one model, e.g.:
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional. Send traces to a local Arize Phoenix server (see README, "Tracing")
# PHOENIX_TRACING=true

# Optional. Model that grades answers in experiments (see README, "Evaluation")
# EVAL_JUDGE_MODEL=openai/gpt-4o
# Optional. How much the chat app logs: DEBUG, INFO (default), WARNING or ERROR
# LOG_LEVEL=INFO
